<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title><%= config.title %></title>
    <style>
        body { font-family: sans-serif; margin: 0; line-height: 1.6; color: #1e293b; }
        header { background: #2563eb; color: white; padding: 1rem; }
        .container { max-width: 800px; margin: 2rem auto; padding: 0 1rem; }
        footer { background: #f8fafc; padding: 2rem; margin-top: 4rem; text-align: center; }
    </style>
</head>
<body>
    <header>
        <div class="container">
            <h1><a href="/" style="color:white;text-decoration:none">0CMS Hexo</a></h1>
        </div>
    </header>
    <main class="container">
        <%- body %>
    </main>
    <footer>
        <p>&copy; 2026 0CMS Hexo Example. Built with Hexo.</p>
    </footer>
</body>
</html>
